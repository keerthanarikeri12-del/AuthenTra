# Backend only. Set these in the process environment; no frontend secrets.
AUTHENTRA_DEMO=0
AUTHENTRA_DB=.local/authentra.db
JWT_SECRET=
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
OWNER_PRIVATE_KEY=
# JSON mapping of institution wallet addresses to server-side signing keys.
ISSUER_PRIVATE_KEYS={}
# Bulk registration settings (read at startup; users always have a five-file limit).
AUTHENTRA_BULK_FILES=100
AUTHENTRA_BULK_BYTES=104857600
AUTHENTRA_UPLOAD_JOBS=4
# Optional: Block explorer template URL with {tx_hash} placeholder (e.g., https://sepolia.etherscan.io/tx/{tx_hash})
EXPLORER_TX_URL=

# ==============================================================================
# Separate Authentication Experiences: OAuth & Institutional Email Policies
# ==============================================================================
# OAuth Base URL for redirection (e.g. https://authentra.example.com or http://localhost:8000)
OAUTH_REDIRECT_BASE=http://localhost:8000

# Google OAuth 2.0 / OIDC credentials (server-side only; never expose in frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple ID / Sign in with Apple credentials (server-side only; never expose in frontend)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Institutional email verification expiration in minutes (default: 60)
EMAIL_VERIFICATION_MINUTES=60
